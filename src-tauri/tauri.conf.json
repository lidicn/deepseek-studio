{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek++ Studio",
  "version": "0.14.17",
  "identifier": "com.deepseek.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://chat.deepseek.com",
    "beforeDevCommand": "npm run build:inject && npm run start",
    "beforeBuildCommand": "node src-tauri/fetch-node.mjs && npm run build:inject && npm run build:host"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' https: data: blob:; script-src 'self' https: 'unsafe-inline' 'unsafe-eval'; style-src 'self' https: 'unsafe-inline'; connect-src 'self' https: wss: ws: http://127.0.0.1:*; img-src 'self' https: data: blob:; font-src 'self' https: data:; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/lidicn/deepseek-studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDRkREREZGRUU0RThCNkIKUldScmkwN3UvOTM5N0ViajJuRkczMCtWRDBhS2prQW1Od3FlVHcvQ2h4RWFJUjNVT3pHWEsvRFkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "host/main.mjs": "host/main.mjs",
      "inject/entry.js": "inject/entry.js",
      "node/node.exe": "node/node.exe",
      "../dist/agent-panel.js": "dist/agent-panel.js",
      "../src/ui/agent.html": "src/ui/agent.html",
      "../src/ui/agent.css": "src/ui/agent.css",
      "../src/ui/agent.webmanifest": "src/ui/agent.webmanifest",
      "../src/ui/agent-sw.js": "src/ui/agent-sw.js",
      "../src/ui/icon-192.png": "src/ui/icon-192.png",
      "../src/ui/icon-512.png": "src/ui/icon-512.png",
      "../dist/mcp-settings-panel.js": "dist/mcp-settings-panel.js",
      "../src/ui/mcp-settings.html": "src/ui/mcp-settings.html",
      "../src/ui/mcp-settings.css": "src/ui/mcp-settings.css",
      "../dist/consent-panel.js": "dist/consent-panel.js",
      "../src/ui/consent-window.html": "src/ui/consent-window.html",
      "../src/ui/consent-window.css": "src/ui/consent-window.css"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  }
}
