{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DeepSeek++ Studio 默认能力（窗口 main / workbench 的权限集合）",
  "windows": ["main", "workbench"],
  "remote": {
    "urls": ["https://chat.deepseek.com"]
  },
  "permissions": [
    "core:default",
    "allow-open-workbench",
    "allow-focus-main-window",
    "allow-open-bot-window",
    "allow-updater-check",
    "allow-updater-install",
    "allow-updater-progress",
    "allow-studio-request-grant",
    "allow-studio-open-mcp-settings"
  ]
}
