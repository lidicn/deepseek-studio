[31m+   // 「代码」等关键词，导致模型不知道有工具而只聊天。修复：不再猜，直接注入。[39m
[31m+   // hasToolIntent 仅用于避免重复注入（已注入则跳过），不再用于决定「是否注入」。[39m
[31m+   const hasResults = pending.length > 0;[39m
[31m+   const block = hasResults ? formatToolResultBlock(pending.slice()) : '';[39m
[31m+   const memoriesBlock = formatMemoriesBlock();[39m
[31m+   if (Array.isArray(parsed.messages)) {[39m
[31m+     let msgs: unknown[] = parsed.messages as unknown[];[39m
[31m+     // 每次发送都重建：技能选择必须跟随当前用户任务，不能沿用上一轮的全量技能块。[39m
[31m+     msgs = injectInstructionIntoMessages(msgs, taskText);[39m
